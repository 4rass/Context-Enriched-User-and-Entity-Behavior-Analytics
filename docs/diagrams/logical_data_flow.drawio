<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="CE-UEBA logical data flow" id="ce-flow"><mxGraphModel grid="1" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="CE-UEBA logical data flow" style="text;html=1;align=left;verticalAlign=top;fontSize=40;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="35" width="1700" height="50" /></mxCell><mxCell id="sub" value="Implemented academic demo • Synthetic inputs • SQLite persistence • Human review" style="text;html=1;align=left;verticalAlign=top;fontSize=23;fontColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="95" width="1700" height="33" /></mxCell><mxCell id="lane1" value="01  PREPARE AND SCORE  /  seed_data.py" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#0f766e;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="171" width="1500" height="32" /></mxCell><mxCell id="seed" value="&lt;b&gt;Seed demo records&lt;/b&gt;&lt;br&gt;&lt;br&gt;IAM / HR: users and roles&lt;br&gt;ITAM: asset inventory&lt;br&gt;ITSM: approved change tickets&lt;br&gt;Behavior: events + raw scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="235" width="380" height="245" /></mxCell><mxCell id="context" value="&lt;b&gt;Resolve event context&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select employee and asset&lt;br&gt;Current / previous role&lt;br&gt;Query employee change tickets&lt;br&gt;Use event and evaluation times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="235" width="380" height="245" /></mxCell><mxCell id="engine" value="&lt;b&gt;Evaluate risk&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match user, asset, ticket window&lt;br&gt;Apply legitimate / suspicious rules&lt;br&gt;Clamp score to 0–100&lt;br&gt;Derive severity and suppression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="235" width="380" height="245" /></mxCell><mxCell id="persist" value="&lt;b&gt;Persist the result&lt;/b&gt;&lt;br&gt;&lt;br&gt;seed_data.py writes Alert&lt;br&gt;Raw + adjusted scores&lt;br&gt;Reason + JSON context factors&lt;br&gt;Commit records to SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="235" width="380" height="245" /></mxCell><mxCell id="review" value="&lt;b&gt;Save analyst status&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /alerts/&amp;lt;id&amp;gt;/review&lt;br&gt;Validate CSRF token and status&lt;br&gt;Update alerts.analyst_status&lt;br&gt;Commit the analyst decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="640" width="380" height="245" /></mxCell><mxCell id="analyst" value="&lt;b&gt;Investigate and decide&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read alert factors and evidence&lt;br&gt;Inspect employee risk profile&lt;br&gt;Choose an analyst status&lt;br&gt;Submit the review form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="640" width="380" height="245" /></mxCell><mxCell id="web" value="&lt;b&gt;Serve the SOC dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flask queries stored records&lt;br&gt;Apply the selected filters&lt;br&gt;Render metrics, alerts and charts&lt;br&gt;Open alert and user detail pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="640" width="380" height="245" /></mxCell><mxCell id="db" value="&lt;b&gt;SQLite data store&lt;/b&gt;&lt;br&gt;&lt;br&gt;users • roles • it_assets&lt;br&gt;change_tickets • behavioral_logs&lt;br&gt;alerts: scores + review status&lt;br&gt;instance/ce_ueba.db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontColor=#0f172a;fontSize=20;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1350" y="640" width="380" height="245" /></mxCell><mxCell id="e1" value="" source="seed" target="context" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" source="context" target="engine" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" source="engine" target="persist" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Commit" source="persist" target="db" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="lane2" value="02  EXPLORE AND REVIEW  /  app.py + browser" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#7c3aed;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="566" width="1400" height="32" /></mxCell><mxCell id="e5" value="" source="db" target="web" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="" source="web" target="analyst" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" source="analyst" target="review" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="Persist review status; later requests read the updated record" source="review" target="db" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;fontSize=18;labelBackgroundColor=#f8fafc;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="250" y="963" /><mxPoint x="1540" y="963" /></Array></mxGeometry></mxCell><mxCell id="foot" value="Context records and behavioral logs are also stored in the same SQLite database during seeding.&lt;br&gt;No live enterprise connectors or trained ML model. Analyst review changes status; it does not trigger rescoring." style="text;html=1;align=left;verticalAlign=top;fontSize=21;fontColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1007" width="1690" height="62" /></mxCell></root></mxGraphModel></diagram></mxfile>